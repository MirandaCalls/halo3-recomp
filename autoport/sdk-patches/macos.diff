+
+bool VulkanCommandProcessor::IsMemExportComputeEnabled() {
+  // autoport: AUTOPORT_MEMEXPORT_COMPUTE=1 (with guest memory imported).
+  static const bool enabled = [] {
+    const char* value = std::getenv("AUTOPORT_MEMEXPORT_COMPUTE");
+    return value && std::strcmp(value, "0") != 0;
+  }();
+  return enabled;
+}
+
+VkPipeline VulkanCommandProcessor::GetMemExportComputePipeline(
+    VulkanShader::VulkanTranslation& translation, VkPipelineLayout pipeline_layout) {
+  auto it = memexport_compute_pipelines_.find(&translation);
+  if (it != memexport_compute_pipelines_.end()) {
+    return it->second;
+  }
+  VkPipeline pipeline = VK_NULL_HANDLE;
+  REXGPU_INFO("autoport: creating the memexport compute pipeline for vertex shader {:016X}",
+              translation.shader().ucode_data_hash());
+  VkShaderModule shader_module = translation.GetOrCreateShaderModule();
+  if (shader_module != VK_NULL_HANDLE) {
+    pipeline =
+        ui::vulkan::util::CreateComputePipeline(GetVulkanDevice(), pipeline_layout, shader_module);
+  }
+  if (pipeline != VK_NULL_HANDLE) {
+    REXGPU_INFO("autoport: vertex shader {:016X} memexports from a compute pipeline",
+                translation.shader().ucode_data_hash());
+  } else {
+    REXGPU_WARN(
+        "autoport: couldn't create a memexport compute pipeline for vertex shader {:016X}, "
+        "drawing it instead",
+        translation.shader().ucode_data_hash());
+  }
+  memexport_compute_pipelines_.emplace(&translation, pipeline);
+  return pipeline;
+}
+
+bool VulkanCommandProcessor::IssueMemExportCompute(
+    VulkanShader& vertex_shader, VulkanShader::VulkanTranslation& vertex_shader_translation,
+    VkPipeline pipeline, const VulkanPipelineCache::PipelineLayoutProvider& pipeline_layout,
+    const PrimitiveProcessor::ProcessingResult& primitive_processing_result,
+    bool primitive_polygonal, uint32_t used_texture_mask,
+    reg::RB_DEPTHCONTROL normalized_depth_control) {
+  // A draw whose vertex shader memexports and which rasterizes nothing (Halo 3
+  // updates particles this way, each followed by a draw reading the result)
+  // runs as a compute dispatch of the shader. Apple GPUs have no barriers
+  // inside a render pass, so between such a draw and the next one reading its
+  // output the render pass had to end, and on a tile-based GPU every end
+  // stores the render targets and every begin loads them again (~110 times a
+  // frame in Halo 3). The dispatches are recorded in front of the render pass
+  // that's open (FlushMemExportCompute inserts them when it ends), unless what
+  // they access conflicts with the draws already in it.
+  const RegisterFile& regs = *register_file_;
+  auto vgt_draw_initiator = regs.Get<reg::VGT_DRAW_INITIATOR>();
+  uint32_t vertex_count = primitive_processing_result.guest_draw_vertex_count;
+  if (!vertex_count) {
+    return true;
+  }
+
+  // The compute variant reads the guest's indices itself, from the guest's
+  // index buffer, whatever the host would have drawn.
+  PrimitiveProcessor::ProcessingResult compute_processing_result = primitive_processing_result;
+  compute_processing_result.host_vertex_shader_type =
+      Shader::HostVertexShaderType::kMemExportCompute;
+  bool guest_dma = vgt_draw_initiator.source_select == xenos::SourceSelect::kDMA;
+  uint32_t guest_index_size =
+      vgt_draw_initiator.index_size == xenos::IndexFormat::kInt32 ? 4 : 2;
+  if (guest_dma) {
+    compute_processing_result.index_buffer_type =
+        PrimitiveProcessor::ProcessedIndexBufferType::kGuestDMA;
+    compute_processing_result.host_index_format = vgt_draw_initiator.index_size;
+    bool guest_primitive_reset = false;
+    if (regs.Get<reg::PA_SU_SC_MODE_CNTL>().multi_prim_ib_ena) {
+      switch (vgt_draw_initiator.prim_type) {
+        case xenos::PrimitiveType::kLineStrip:
+        case xenos::PrimitiveType::kTriangleFan:
+        case xenos::PrimitiveType::kTriangleStrip:
+        case xenos::PrimitiveType::kLineLoop:
+        case xenos::PrimitiveType::kQuadStrip:
+        case xenos::PrimitiveType::kPolygon:
+        case xenos::PrimitiveType::k2DLineStrip:
+        case xenos::PrimitiveType::k2DTriStrip:
+          guest_primitive_reset = true;
+          break;
+        default:
+          break;
+      }
+    }
+    compute_processing_result.host_primitive_reset_enabled = guest_primitive_reset;
+  } else {
+    compute_processing_result.index_buffer_type = PrimitiveProcessor::ProcessedIndexBufferType::kNone;
+    compute_processing_result.host_primitive_reset_enabled = false;
+  }
+
+  // What the dispatch reads and writes in the shared memory.
+  draw_read_ranges_.clear();
+  const Shader::ConstantRegisterMap& constant_map_vertex = vertex_shader.constant_register_map();
+  for (uint32_t i = 0; i < rex::countof(constant_map_vertex.vertex_fetch_bitmap); ++i) {
+    uint32_t vfetch_bits_remaining = constant_map_vertex.vertex_fetch_bitmap[i];
+    uint32_t j;
+    while (rex::bit_scan_forward(vfetch_bits_remaining, &j)) {
+      vfetch_bits_remaining &= ~(uint32_t(1) << j);
+      xenos::xe_gpu_vertex_fetch_t vfetch_constant = regs.GetVertexFetch(i * 32 + j);
+      if (vfetch_constant.type != xenos::FetchConstantType::kVertex) {
+        continue;
+      }
+      uint32_t address = (vfetch_constant.address & 0x07FFFFFF) << 2;
+      uint32_t size = vfetch_constant.size << 2;
+      if (!shared_memory_->RequestRange(address, size)) {
+        return false;
+      }
+      draw_read_ranges_.emplace_back(address, size);
+    }
+  }
+  texture_cache_->GetBoundTextureMemoryRanges(used_texture_mask, draw_read_ranges_);
+  if (guest_dma) {
+    uint32_t index_buffer_size = vertex_count * guest_index_size;
+    if (!shared_memory_->RequestRange(compute_processing_result.guest_index_base,
+                                      index_buffer_size)) {
+      return false;
+    }
+    draw_read_ranges_.emplace_back(compute_processing_result.guest_index_base, index_buffer_size);
+  }
+  uint32_t written_start = UINT32_MAX, written_end = 0;
+  for (const draw_util::MemExportRange& memexport_range : memexport_ranges_) {
+    uint32_t base = memexport_range.base_address_dwords << 2;
+    if (!shared_memory_->RequestRange(base, memexport_range.size_bytes)) {
+      return false;
+    }
+    written_start = std::min(written_start, base);
+    written_end = std::max(written_end, base + memexport_range.size_bytes);
+  }
+  if (written_start >= written_end) {
+    // Unknown destinations.
+    if (!shared_memory_->RequestRange(0, SharedMemory::kBufferSize)) {
+      return false;
+    }
+    written_start = 0;
+    written_end = SharedMemory::kBufferSize;
+  }
+  auto reads_overlap = [this](const VulkanSharedMemory::IntervalSet& set) {
+    for (const std::pair<uint32_t, uint32_t>& read_range : draw_read_ranges_) {
+      uint32_t start = std::min(read_range.first, SharedMemory::kBufferSize);
+      if (set.Overlaps(start,
+                       start + std::min(read_range.second, SharedMemory::kBufferSize - start))) {
+        return true;
+      }
+    }
+    return false;
+  };
+
+  // In front of the open render pass, or recorded right away.
+  // AUTOPORT_MEMEXPORT_COMPUTE=inplace ends the pass instead, keeping the
+  // guest's order (to tell translation problems from ordering problems);
+  // =emptypass does so only when the pass already has draws (to tell ordering
+  // problems from side effects of continuing the pass).
+  static const int memexport_compute_order_mode = [] {
+    const char* value = std::getenv("AUTOPORT_MEMEXPORT_COMPUTE");
+    if (value && !std::strcmp(value, "inplace")) {
+      return 1;
+    }
+    if (value && !std::strcmp(value, "emptypass")) {
+      return 2;
+    }
+    return 0;
+  }();
+  if (in_render_pass_ && (memexport_compute_order_mode == 1 ||
+                          (memexport_compute_order_mode == 2 && render_pass_draw_count_))) {
+    EndRenderPass();
+  }
+  bool in_front_of_pass = in_render_pass_ && memexport_compute_insert_position_ != SIZE_MAX;
+  if (in_front_of_pass && (render_pass_draw_reads_.Overlaps(written_start, written_end) ||
+                           render_pass_draw_writes_.Overlaps(written_start, written_end) ||
+                           reads_overlap(render_pass_draw_writes_))) {
+    ++memexport_compute_stats_.pass_ended_for_conflict;
+    EndRenderPass();
+    in_front_of_pass = false;
+  }
+  if (!in_front_of_pass) {
+    FlushMemExportCompute();
+    memexport_compute_insert_position_ = deferred_command_buffer_.stream_position();
+  }
+
+  // Constants and descriptors, as for drawing with this shader, but without
+  // touching the graphics bindings: binding these sets for graphics with the
+  // compute layout, in the middle of the render pass, could leave the draws
+  // after it with resources in the wrong slots (MoltenVK assigns Metal
+  // indices from the layout).
+  const PipelineLayout* graphics_pipeline_layout = current_guest_graphics_pipeline_layout_;
+  uint32_t graphics_descriptor_sets_bound = current_graphics_descriptor_sets_bound_up_to_date_;
+  SetGuestPipelineLayout(static_cast<const PipelineLayout*>(&pipeline_layout));
+  draw_util::ViewportInfo viewport_info = {};
+  UpdateSystemConstantValues(primitive_polygonal, compute_processing_result, false, vertex_count,
+                             viewport_info, used_texture_mask, normalized_depth_control, 0,
+                             nullptr);
+  bool bindings_updated = UpdateBindings(&vertex_shader, nullptr, false);
+  current_guest_graphics_pipeline_layout_ = graphics_pipeline_layout;
+  current_graphics_descriptor_sets_bound_up_to_date_ = graphics_descriptor_sets_bound;
+  // current_graphics_descriptor_sets_ now holds this dispatch's sets: make the
+  // next draw write its own (the shared memory set is the same for all).
+  uint32_t dispatch_descriptor_sets_mask =
+      ~(UINT32_C(1) << SpirvShaderTranslator::kDescriptorSetSharedMemoryAndEdram);
+  current_graphics_descriptor_set_values_up_to_date_ &= ~dispatch_descriptor_sets_mask;
+  current_graphics_descriptor_sets_bound_up_to_date_ &= ~dispatch_descriptor_sets_mask;
+  if (!bindings_updated) {
+    return false;
+  }
+
+  DeferredCommandBuffer& command_buffer = memexport_compute_command_buffer_;
+  VkBufferMemoryBarrier shared_memory_barrier = {};
+  shared_memory_barrier.sType = VK_STRUCTURE_TYPE_BUFFER_MEMORY_BARRIER;
+  shared_memory_barrier.srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+  shared_memory_barrier.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+  shared_memory_barrier.buffer = shared_memory_->buffer();
+  shared_memory_barrier.offset = 0;
+  shared_memory_barrier.size = VK_WHOLE_SIZE;
+  if (command_buffer.empty()) {
+    // After everything recorded before (uploads, earlier memexport).
+    shared_memory_barrier.srcAccessMask = VK_ACCESS_SHADER_WRITE_BIT | VK_ACCESS_TRANSFER_WRITE_BIT;
+    shared_memory_barrier.dstAccessMask = VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_SHADER_WRITE_BIT;
+    command_buffer.CmdVkPipelineBarrier(
+        guest_shader_pipeline_stages_ | VK_PIPELINE_STAGE_VERTEX_INPUT_BIT |
+            VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT | VK_PIPELINE_STAGE_TRANSFER_BIT,
+        VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, 0, 0, nullptr, 1, &shared_memory_barrier, 0, nullptr);
+  } else if (memexport_compute_writes_.Overlaps(written_start, written_end) ||
+             memexport_compute_reads_.Overlaps(written_start, written_end) ||
+             reads_overlap(memexport_compute_writes_)) {
+    // After the dispatches before this one that access the same memory.
+    shared_memory_barrier.srcAccessMask = VK_ACCESS_SHADER_WRITE_BIT;
+    shared_memory_barrier.dstAccessMask = VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_SHADER_WRITE_BIT;
+    command_buffer.CmdVkPipelineBarrier(VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
+                                        VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, 0, 0, nullptr, 1,
+                                        &shared_memory_barrier, 0, nullptr);
+    memexport_compute_reads_.Clear();
+    memexport_compute_writes_.Clear();
+  }
+  command_buffer.CmdVkBindPipeline(VK_PIPELINE_BIND_POINT_COMPUTE, pipeline);
+  uint32_t descriptor_set_count =
+      (vertex_shader.GetTextureBindingsAfterTranslation().empty() &&
+       vertex_shader.GetSamplerBindingsAfterTranslation().empty())
+          ? uint32_t(SpirvShaderTranslator::kDescriptorSetConstants) + 1
+          : uint32_t(SpirvShaderTranslator::kDescriptorSetTexturesVertex) + 1;
+  command_buffer.CmdVkBindDescriptorSets(VK_PIPELINE_BIND_POINT_COMPUTE,
+                                         pipeline_layout.GetPipelineLayout(), 0,
+                                         descriptor_set_count, current_graphics_descriptor_sets_, 0,
+                                         nullptr);
+  // Vertices are indexed as x + y * kMemExportComputeDispatchX invocations,
+  // kMemExportComputeWorkgroupSize per workgroup.
+  constexpr uint32_t kWorkgroupSize = SpirvShaderTranslator::kMemExportComputeWorkgroupSize;
+  constexpr uint32_t kRowInvocations = SpirvShaderTranslator::kMemExportComputeDispatchX;
+  uint32_t group_count_x =
+      (std::min(vertex_count, kRowInvocations) + kWorkgroupSize - 1) / kWorkgroupSize;
+  uint32_t group_count_y = (vertex_count + kRowInvocations - 1) / kRowInvocations;
+  command_buffer.CmdVkDispatch(group_count_x, group_count_y, 1);
+  for (const std::pair<uint32_t, uint32_t>& read_range : draw_read_ranges_) {
+    uint32_t start = std::min(read_range.first, SharedMemory::kBufferSize);
+    memexport_compute_reads_.Add(
+        start, start + std::min(read_range.second, SharedMemory::kBufferSize - start));
+  }
+  memexport_compute_writes_.Add(written_start, written_end);
+
+  // Invalidate textures in the memexported memory.
+  if (!memexport_ranges_.empty()) {
+    for (const draw_util::MemExportRange& memexport_range : memexport_ranges_) {
+      shared_memory_->RangeWrittenByGpu(memexport_range.base_address_dwords << 2,
+                                        memexport_range.size_bytes);
+    }
+  } else {
+    shared_memory_->RangeWrittenByGpu(0, SharedMemory::kBufferSize);
+  }
+
+  if (in_front_of_pass) {
+    ++memexport_compute_stats_.moved_before_pass;
+    if (IsMemExportComputeLogEnabled()) {
+      memexport_compute_pass_log_moved_past_draws_ |= render_pass_draw_count_ != 0;
+      memexport_compute_pass_log_ +=
+          fmt::format("\n  MOVED dispatch vs {:016X}, {} vertices, writes", 
+                      vertex_shader.ucode_data_hash(), vertex_count);
+      if (memexport_ranges_.empty()) {
+        memexport_compute_pass_log_ += " (unknown: all)";
+      }
+      for (const draw_util::MemExportRange& memexport_range : memexport_ranges_) {
+        memexport_compute_pass_log_ += fmt::format(
+            " {:08X}+{:X}", memexport_range.base_address_dwords << 2, memexport_range.size_bytes);
+      }
+      memexport_compute_pass_log_ += ", reads";
+      for (const std::pair<uint32_t, uint32_t>& read_range : draw_read_ranges_) {
+        memexport_compute_pass_log_ +=
+            fmt::format(" {:08X}+{:X}", read_range.first, read_range.second);
+      }
+    }
+  } else {
+    ++memexport_compute_stats_.outside_pass;
+    FlushMemExportCompute();
+  }
+  return true;
+}
+
+void VulkanCommandProcessor::FlushMemExportCompute() {
+  size_t position = memexport_compute_insert_position_;
+  memexport_compute_insert_position_ = SIZE_MAX;
+  // Only passes with tessellated draws (Halo 3's water).
+  if (IsMemExportComputeLogEnabled() && memexport_compute_pass_log_moved_past_draws_ &&
+      memexport_compute_pass_log_.find(" tessellated") != std::string::npos) {
+    static uint32_t passes_logged = 0;
+    if (passes_logged < 40) {
+      ++passes_logged;
+      REXGPU_INFO("autoport: memexport compute pass {} (frame {}):{}", passes_logged,
+                  frame_current_, memexport_compute_pass_log_);
+    }
+  }
+  memexport_compute_pass_log_.clear();
+  memexport_compute_pass_log_moved_past_draws_ = false;
+  if (memexport_compute_command_buffer_.empty()) {
+    return;
+  }
+  // Make the dispatches' writes visible to everything after them.
+  VkBufferMemoryBarrier shared_memory_barrier = {};
+  shared_memory_barrier.sType = VK_STRUCTURE_TYPE_BUFFER_MEMORY_BARRIER;
+  shared_memory_barrier.srcAccessMask = VK_ACCESS_SHADER_WRITE_BIT;
+  shared_memory_barrier.dstAccessMask =
+      VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_SHADER_WRITE_BIT | VK_ACCESS_INDEX_READ_BIT |
+      VK_ACCESS_VERTEX_ATTRIBUTE_READ_BIT | VK_ACCESS_TRANSFER_READ_BIT |
+      VK_ACCESS_TRANSFER_WRITE_BIT;
+  shared_memory_barrier.srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+  shared_memory_barrier.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+  shared_memory_barrier.buffer = shared_memory_->buffer();
+  shared_memory_barrier.offset = 0;
+  shared_memory_barrier.size = VK_WHOLE_SIZE;
+  memexport_compute_command_buffer_.CmdVkPipelineBarrier(
+      VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
+      guest_shader_pipeline_stages_ | VK_PIPELINE_STAGE_VERTEX_INPUT_BIT |
+          VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT | VK_PIPELINE_STAGE_TRANSFER_BIT,
+      0, 0, nullptr, 1, &shared_memory_barrier, 0, nullptr);
+  if (position == SIZE_MAX) {
+    position = deferred_command_buffer_.stream_position();
+  }
+  deferred_command_buffer_.InsertAt(position, memexport_compute_command_buffer_);
+  memexport_compute_command_buffer_.Reset();
+  memexport_compute_reads_.Clear();
+  memexport_compute_writes_.Clear();
+  // The compute pipeline bound before what was recorded after the insertion
+  // point is no longer the bound one there.
+  current_external_compute_pipeline_ = VK_NULL_HANDLE;
+}
+
+void VulkanCommandProcessor::SetGuestPipelineLayout(const PipelineLayout* pipeline_layout) {
+  // If the layout changes, invalidate incompatible descriptor sets before
+  // updating current_guest_graphics_pipeline_layout_.
+  if (current_guest_graphics_pipeline_layout_ != pipeline_layout) {
+    if (current_guest_graphics_pipeline_layout_) {
+      // Keep descriptor set layouts for which the new pipeline layout is
+      // compatible with the previous one (pipeline layouts are compatible for
+      // set N if set layouts 0 through N are compatible).
+      uint32_t descriptor_sets_kept = uint32_t(SpirvShaderTranslator::kDescriptorSetCount);
+      if (current_guest_graphics_pipeline_layout_->descriptor_set_layout_textures_vertex_ref() !=
+          pipeline_layout->descriptor_set_layout_textures_vertex_ref()) {
+        descriptor_sets_kept = std::min(
+            descriptor_sets_kept, uint32_t(SpirvShaderTranslator::kDescriptorSetTexturesVertex));
+      }
+      if (current_guest_graphics_pipeline_layout_->descriptor_set_layout_textures_pixel_ref() !=
+          pipeline_layout->descriptor_set_layout_textures_pixel_ref()) {
+        descriptor_sets_kept = std::min(
+            descriptor_sets_kept, uint32_t(SpirvShaderTranslator::kDescriptorSetTexturesPixel));
+      }
+      // Invalidate descriptor set bindings for incompatible sets.
+      current_graphics_descriptor_sets_bound_up_to_date_ &=
+          (UINT32_C(1) << descriptor_sets_kept) - 1;
+    } else {
+      // No or unknown pipeline layout previously bound - all bindings are in an
+      // indeterminate state.
+      current_graphics_descriptor_sets_bound_up_to_date_ = 0;
+    }
+    current_guest_graphics_pipeline_layout_ = pipeline_layout;
+  }
+}
