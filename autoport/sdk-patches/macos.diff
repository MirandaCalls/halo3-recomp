+struct AutoportTextureStats {
+  struct Entry {
+    uint32_t loads = 0;
+    uint32_t cpu_invalidations = 0;
+    uint32_t gpu_invalidations = 0;
+  };
+  bool enabled = std::getenv("AUTOPORT_TEXTURE_STATS") != nullptr;
