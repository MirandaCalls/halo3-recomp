+++ b/src/graphics/command_processor.cpp
@@ -11,7 +11,12 @@
 
 #include <algorithm>
 #include <unistd.h>
+#if defined(__APPLE__)
+#include <mach/mach.h>
+#include <mach/mach_vm.h>
+#else
 #include <sys/uio.h>
+#endif
 #include <vector>
 #include <string>
 #include <filesystem>
@@ -801,9 +806,19 @@ void DumpPhysical(const memory::Memory* memory, const std::string& path) {
   std::vector<uint8_t> buffer(kChunk);
   const uint8_t* base = memory->TranslatePhysical<const uint8_t*>(0);
   for (size_t off = 0; off < kTotal; off += kChunk) {
+#if defined(__APPLE__)
+    // macOS has no process_vm_readv; mach_vm_read_overwrite also fails cleanly on
+    // unmapped pages instead of faulting
+    mach_vm_size_t bytes_read = 0;
+    bool readable = mach_vm_read_overwrite(mach_task_self(), mach_vm_address_t(base + off), kChunk,
+                                           mach_vm_address_t(buffer.data()), &bytes_read) == KERN_SUCCESS &&
+                    bytes_read == kChunk;
+#else
     iovec local{buffer.data(), kChunk};
     iovec remote{const_cast<uint8_t*>(base + off), kChunk};
-    if (process_vm_readv(getpid(), &local, 1, &remote, 1, 0) != ssize_t(kChunk)) {
+    bool readable = process_vm_readv(getpid(), &local, 1, &remote, 1, 0) == ssize_t(kChunk);
+#endif
+    if (!readable) {
       std::fill(buffer.begin(), buffer.end(), uint8_t(0));  // unreadable range
     }
     std::fwrite(buffer.data(), 1, kChunk, f);
