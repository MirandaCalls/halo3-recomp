+class DrawStateLog {
+ public:
+  static DrawStateLog& Get() {
+    static DrawStateLog log;
+    return log;
+  }
+
+  void OnSwap(uint64_t frame) {
+    if (path_.empty()) {
+      return;
+    }
+    if (frames_left_) {
+      frame_ = frame;
+      if (!--frames_left_) {
+        file_.close();
+        REXGPU_INFO("autoport: draw log saved to {}", path_);
+      }
+      return;
+    }
+    if (frame % 15) {
+      return;
+    }
+    std::error_code ec;
+    std::string trigger = path_ + ".trigger";
+    if (!std::filesystem::exists(trigger, ec)) {
+      return;
+    }
+    std::filesystem::remove(trigger, ec);
+    file_.open(path_, std::ios::trunc);
+    file_ << "# frame draw vs ps prim indices regs...\n";
+    frames_left_ = 2;
+    frame_ = frame;
+    draw_ = 0;
+  }
