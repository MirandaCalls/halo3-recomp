+  std::string last_path_;
+  bool capturing_ = false;
+  uint32_t frames_left_ = 0;
+  Id (*get_class_)(const char*) = nullptr;
+  Sel (*register_selector_)(const char*) = nullptr;
+  void* msg_send_ = nullptr;
+  Id (*create_device_)() = nullptr;
+};
