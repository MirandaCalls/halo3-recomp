+// autoport: AUTOPORT_DRAW_LOG=<file> records the state of every draw of the
+// next two guest frames once <file>.trigger exists (touch it while playing):
+// shader hashes, primitive and index count, and the raw values of the render
+// target, depth/stencil, alpha test, blend, polygon offset, index buffer and
+// first vertex fetch constant registers. Draws of the same mesh in different
+// passes share their index and vertex buffer addresses, so the passes of a
+// multipass effect can be lined up and compared (tools/draw-log-pairs.py).
+class DrawStateLog {
+ public:
+  static DrawStateLog& Get() {
+    static DrawStateLog log;
+    return log;
+  }
+
+  void OnSwap(uint64_t frame) {
+    if (path_.empty()) {
+      return;
+    }
+    if (frames_left_) {
+      frame_ = frame;
+      if (!--frames_left_) {
+        file_.close();
+        REXGPU_INFO("autoport: draw log saved to {}", path_);
+      }
+      return;
+    }
+    if (frame % 15) {
+      return;
+    }
+    std::error_code ec;
+    std::string trigger = path_ + ".trigger";
+    if (!std::filesystem::exists(trigger, ec)) {
+      return;
+    }
+    std::filesystem::remove(trigger, ec);
+    file_.open(path_, std::ios::trunc);
+    file_ << "# frame draw vs ps prim indices regs...\n";
+    frames_left_ = 2;
+    frame_ = frame;
+    draw_ = 0;
+  }
+
+  bool active() const { return frames_left_ != 0; }
+
+  void LogDraw(const RegisterFile& regs, uint64_t vs_hash, uint64_t ps_hash,
+               xenos::PrimitiveType prim_type, uint32_t index_count) {
+    static constexpr std::pair<const char*, uint32_t> kRegisters[] = {
+        {"surface", XE_GPU_REG_RB_SURFACE_INFO},
+        {"color0", XE_GPU_REG_RB_COLOR_INFO},
+        {"color1", XE_GPU_REG_RB_COLOR1_INFO},
+        {"depthinfo", XE_GPU_REG_RB_DEPTH_INFO},
+        {"modecontrol", XE_GPU_REG_RB_MODECONTROL},
+        {"depthcontrol", XE_GPU_REG_RB_DEPTHCONTROL},
+        {"stencil", XE_GPU_REG_RB_STENCILREFMASK},
+        {"stencilbf", XE_GPU_REG_RB_STENCILREFMASK_BF},
+        {"colorcontrol", XE_GPU_REG_RB_COLORCONTROL},
+        {"alpharef", XE_GPU_REG_RB_ALPHA_REF},
+        {"blend0", XE_GPU_REG_RB_BLENDCONTROL0},
+        {"colormask", XE_GPU_REG_RB_COLOR_MASK},
+        {"scmode", XE_GPU_REG_PA_SU_SC_MODE_CNTL},
+        {"polyfrontscale", XE_GPU_REG_PA_SU_POLY_OFFSET_FRONT_SCALE},
+        {"polyfrontoffset", XE_GPU_REG_PA_SU_POLY_OFFSET_FRONT_OFFSET},
+        {"polybackscale", XE_GPU_REG_PA_SU_POLY_OFFSET_BACK_SCALE},
+        {"polybackoffset", XE_GPU_REG_PA_SU_POLY_OFFSET_BACK_OFFSET},
+        {"vte", XE_GPU_REG_PA_CL_VTE_CNTL},
+        {"indexbase", XE_GPU_REG_VGT_DMA_BASE},
+        {"indexsize", XE_GPU_REG_VGT_DMA_SIZE},
+        {"initiator", XE_GPU_REG_VGT_DRAW_INITIATOR},
+        {"vf0", XE_GPU_REG_SHADER_CONSTANT_FETCH_00_0},
+        {"vf0b", XE_GPU_REG_SHADER_CONSTANT_FETCH_00_0 + 1},
+    };
+    std::string line = fmt::format("{} {} {:016X} {:016X} {} {}", frame_, draw_++, vs_hash,
+                                   ps_hash, uint32_t(prim_type), index_count);
+    for (const auto& [name, index] : kRegisters) {
+      line += fmt::format(" {}={:08X}", name, regs[index]);
+    }
+    // Texture fetch constants (6 dwords) and pixel shader float constants (4
+    // dwords), slots from AUTOPORT_DRAW_LOG_TF / AUTOPORT_DRAW_LOG_PSC.
+    for (uint32_t slot : texture_slots_) {
+      line += fmt::format(" tf{}=", slot);
+      for (uint32_t i = 0; i < 6; ++i) {
+        line += fmt::format("{}{:08X}", i ? ":" : "",
+                            regs[XE_GPU_REG_SHADER_CONSTANT_FETCH_00_0 + slot * 6 + i]);
+      }
+    }
+    for (uint32_t slot : pixel_constant_slots_) {
+      line += fmt::format(" psc{}=", slot);
+      for (uint32_t i = 0; i < 4; ++i) {
+        line += fmt::format("{}{:08X}", i ? ":" : "",
+                            regs[XE_GPU_REG_SHADER_CONSTANT_256_X + slot * 4 + i]);
+      }
+    }
+    file_ << line << '\n';
+  }
+
+ private:
+  DrawStateLog() {
+    const char* path = std::getenv("AUTOPORT_DRAW_LOG");
+    if (path && *path) {
+      path_ = path;
+      REXGPU_INFO("autoport: draw log armed; create {}.trigger to record two frames", path_);
+    }
+    auto parse_slots = [](const char* name, const char* defaults, uint32_t limit) {
+      const char* list = std::getenv(name);
+      std::string text = list ? list : defaults;
+      std::vector<uint32_t> slots;
+      for (const char* p = text.c_str(); *p;) {
+        char* end = nullptr;
+        unsigned long value = std::strtoul(p, &end, 10);
+        if (end == p) {
+          break;
+        }
+        if (value < limit) {
+          slots.push_back(uint32_t(value));
+        }
+        p = *end == ',' ? end + 1 : end;
+      }
+      return slots;
+    };
+    texture_slots_ = parse_slots("AUTOPORT_DRAW_LOG_TF", "0,1,2,3,10", 32);
+    pixel_constant_slots_ = parse_slots("AUTOPORT_DRAW_LOG_PSC", "0,98,99,108,234,235", 256);
+  }
+
+  std::vector<uint32_t> texture_slots_;
+  std::vector<uint32_t> pixel_constant_slots_;
+  std::string path_;
+  std::ofstream file_;
+  uint32_t frames_left_ = 0;
+  uint64_t frame_ = 0;
+  uint32_t draw_ = 0;
+};
