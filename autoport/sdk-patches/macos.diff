+#if REX_PLATFORM_MAC
+// autoport: Metal frame capture without a debugger. With AUTOPORT_METAL_CAPTURE
+// set to a directory (and MTL_CAPTURE_ENABLED=1, which Metal requires), creating
+// a file named "capture" there saves the next few guest frames as
+// frame-<n>.gputrace, which Xcode opens with pixel history and shader debugging.
+// Several frames, because a frame's work reaches the GPU in submissions that
+// straddle the swap, so a swap-to-swap window catches little of it.
+// Metal is reached through the Objective-C runtime, looked up at run time, so
+// nothing extra is linked.
+class MetalFrameCapture {
+ public:
+  static MetalFrameCapture& Get() {
+    static MetalFrameCapture capture;
+    return capture;
+  }
+
+  // Called once per guest frame.
+  void OnSwap(uint64_t frame) {
+    if (directory_.empty()) {
+      return;
+    }
+    if (capturing_) {
+      if (--frames_left_) {
+        return;
+      }
+      Send<void>(Manager(), "stopCapture");
+      capturing_ = false;
+      REXGPU_INFO("autoport: Metal frame capture saved to {}", last_path_);
+      return;
+    }
+    // Checking for the trigger every frame would cost a syscall per frame.
+    if (frame % 15) {
+      return;
+    }
+    std::error_code ec;
+    std::filesystem::path trigger = std::filesystem::path(directory_) / "capture";
+    if (!std::filesystem::exists(trigger, ec)) {
+      return;
+    }
+    std::filesystem::remove(trigger, ec);
+    last_path_ =
+        (std::filesystem::path(directory_) / ("frame-" + std::to_string(frame) + ".gputrace"))
+            .string();
+    capturing_ = Start(last_path_);
+    frames_left_ = kCapturedSwaps;
+    if (!capturing_) {
+      REXGPU_ERROR(
+          "autoport: Metal frame capture failed to start (is MTL_CAPTURE_ENABLED=1 set?)");
+    }
+  }
+
+ private:
+  using Id = void*;
+  using Sel = void*;
+
+  MetalFrameCapture() {
+    const char* directory = std::getenv("AUTOPORT_METAL_CAPTURE");
+    if (!directory || !*directory) {
+      return;
+    }
+    get_class_ = reinterpret_cast<Id (*)(const char*)>(dlsym(RTLD_DEFAULT, "objc_getClass"));
+    register_selector_ =
+        reinterpret_cast<Sel (*)(const char*)>(dlsym(RTLD_DEFAULT, "sel_registerName"));
+    msg_send_ = dlsym(RTLD_DEFAULT, "objc_msgSend");
+    void* metal = dlopen("/System/Library/Frameworks/Metal.framework/Metal", RTLD_LAZY);
+    create_device_ =
+        metal ? reinterpret_cast<Id (*)()>(dlsym(metal, "MTLCreateSystemDefaultDevice")) : nullptr;
+    if (!get_class_ || !register_selector_ || !msg_send_ || !create_device_) {
+      REXGPU_ERROR("autoport: Metal frame capture unavailable (Objective-C runtime not found)");
+      return;
+    }
+    directory_ = directory;
+    std::error_code ec;
+    std::filesystem::create_directories(directory_, ec);
+    REXGPU_INFO("autoport: Metal frame capture armed; create {}/capture to capture a frame",
+                directory_);
+  }
+
+  template <typename R, typename... Args>
+  R Send(Id object, const char* selector, Args... args) {
+    return reinterpret_cast<R (*)(Id, Sel, Args...)>(msg_send_)(object,
+                                                                register_selector_(selector),
+                                                                args...);
+  }
+
+  Id Manager() { return Send<Id>(get_class_("MTLCaptureManager"), "sharedCaptureManager"); }
+
+  bool Start(const std::string& path) {
+    // MTLCaptureDestinationGPUTraceDocument
+    constexpr long kGpuTraceDocument = 2;
+    Id manager = Manager();
+    if (!manager || !Send<signed char>(manager, "supportsDestination:", kGpuTraceDocument)) {
+      return false;
+    }
+    // MoltenVK renders with the system default device (the only GPU on Apple
+    // silicon), so capturing it captures every command buffer of the frame.
+    Id device = create_device_();
+    Id descriptor = Send<Id>(Send<Id>(get_class_("MTLCaptureDescriptor"), "alloc"), "init");
+    Send<void>(descriptor, "setCaptureObject:", device);
+    Send<void>(descriptor, "setDestination:", kGpuTraceDocument);
+    Id path_string = Send<Id>(get_class_("NSString"), "stringWithUTF8String:", path.c_str());
+    Send<void>(descriptor, "setOutputURL:",
+               Send<Id>(get_class_("NSURL"), "fileURLWithPath:", path_string));
+    Id error = nullptr;
+    bool started =
+        Send<signed char>(manager, "startCaptureWithDescriptor:error:", descriptor, &error) != 0;
+    Send<void>(descriptor, "release");
+    return started;
+  }
+
+  static constexpr uint32_t kCapturedSwaps = 3;
+
+  std::string directory_;
+  std::string last_path_;
+  bool capturing_ = false;
+  uint32_t frames_left_ = 0;
+  Id (*get_class_)(const char*) = nullptr;
+  Sel (*register_selector_)(const char*) = nullptr;
+  void* msg_send_ = nullptr;
+  Id (*create_device_)() = nullptr;
+};
