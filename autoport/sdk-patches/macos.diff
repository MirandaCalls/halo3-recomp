+bool VulkanSharedMemory::IntervalSet::Overlaps(uint32_t start, uint32_t end) const {
+  if (start >= end || intervals.empty()) {
+    return false;
+  }
+  // The last interval starting before `end`.
+  auto it = intervals.lower_bound(end);
+  if (it == intervals.begin()) {
+    return false;
+  }
+  --it;
+  return it->second > start;
+}
+
+void VulkanSharedMemory::IntervalSet::Add(uint32_t start, uint32_t end) {
+  if (start >= end) {
+    return;
+  }
+  // Merge with every interval touching [start, end).
+  auto it = intervals.lower_bound(start);
+  if (it != intervals.begin()) {
+    auto prev = std::prev(it);
+    if (prev->second >= start) {
+      it = prev;
+    }
+  }
+  while (it != intervals.end() && it->first <= end) {
+    start = std::min(start, it->first);
+    end = std::max(end, it->second);
+    it = intervals.erase(it);
+  }
+  intervals.emplace(start, end);
+}
