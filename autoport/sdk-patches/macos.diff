diff --git a/include/rex/graphics/vulkan/gpu_pass_timer.h b/include/rex/graphics/vulkan/gpu_pass_timer.h
new file mode 100644
index 0000000..8f78d60
--- /dev/null
+++ b/include/rex/graphics/vulkan/gpu_pass_timer.h
@@ -0,0 +1,346 @@
+/**
+ * autoport: GPU time per render pass, for finding the expensive passes.
+ *
+ * Enabled with AUTOPORT_GPU_TIMING_LOG=<file>. Timestamps are written around
+ * every render pass the command processor opens and read back once their
+ * submission has completed, so timing costs no CPU-GPU synchronization. Lines
+ * starting with '#' are comments; every other line is one render pass:
+ *   <seconds> <frame> <kind> <gpu ms> <gap ms> <width>x<height> <draws> <description> <gap work>
+ * kinds: D the game's own draws, X an EDRAM transfer or clear between render
+ *        targets (emulation overhead), P the final copy to the window, and two
+ *        zero-length markers, S at the start and E at the end of a submission,
+ *        so the work before the first and after the last pass is timed too.
+ * gap ms: GPU time since the previous pass in the same submission ended, which
+ *         is compute, copies and barriers outside render passes (-1 if first).
+ * draws:  guest draws recorded in the pass (transfer draws are not counted).
+ * gap work: what was recorded in that gap, as letter-count pairs ("-" if
+ *         nothing): p pipeline barrier batch, t texture load dispatch, b texture
+ *         mip blit, u shared memory upload, r resolve copy, c resolve clear,
+ *         k render target transfer dispatch, d resolve readback, m memexport
+ *         readback, i guest index buffer copy, g swap gamma/copy.
+ * tools/gpu-timing-summary.awk turns the log into a ranked summary.
+ *
+ * With AUTOPORT_GPU_TIMING_PER_DRAW=1 as well, every guest draw gets its own
+ * render pass, and D descriptions end with ",vs=<hash>,ps=<hash>,v=<vertices>"
+ * (hashes as in --dump_shaders file names, ps=0 for no pixel shader). Splitting
+ * passes adds load/store work, so totals are inflated; use it to rank draws.
+ */
+#pragma once
+
+#include <chrono>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <deque>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include <rex/graphics/vulkan/deferred_command_buffer.h>
+#include <rex/ui/vulkan/device.h>
+
+namespace rex::graphics::vulkan {
+
+class GpuPassTimer {
+ public:
+  ~GpuPassTimer() { Shutdown(); }
+
+  bool enabled() const { return file_ != nullptr; }
+
+  void Initialize(const ui::vulkan::VulkanDevice* vulkan_device) {
+    const char* path = std::getenv("AUTOPORT_GPU_TIMING_LOG");
+    if (!path || !*path) {
+      return;
+    }
+    file_ = std::fopen(path, "w");
+    if (!file_) {
+      return;
+    }
+    vulkan_device_ = vulkan_device;
+    const ui::vulkan::VulkanInstance::Functions& ifn = vulkan_device->vulkan_instance()->functions();
+    VkPhysicalDeviceProperties properties;
+    ifn.vkGetPhysicalDeviceProperties(vulkan_device->physical_device(), &properties);
+    timestamp_period_ns_ = properties.limits.timestampPeriod;
+    uint32_t queue_family_count = 0;
+    ifn.vkGetPhysicalDeviceQueueFamilyProperties(vulkan_device->physical_device(),
+                                                 &queue_family_count, nullptr);
+    std::vector<VkQueueFamilyProperties> queue_families(queue_family_count);
+    ifn.vkGetPhysicalDeviceQueueFamilyProperties(vulkan_device->physical_device(),
+                                                 &queue_family_count, queue_families.data());
+    uint32_t valid_bits = 0;
+    uint32_t family = vulkan_device->queue_family_graphics_compute();
+    if (family < queue_family_count) {
+      valid_bits = queue_families[family].timestampValidBits;
+    }
+    timestamp_mask_ = valid_bits >= 64 ? ~uint64_t(0) : (uint64_t(1) << valid_bits) - 1;
+    // Not in the device's function table, so loaded here.
+    cmd_write_timestamp_ = reinterpret_cast<PFN_vkCmdWriteTimestamp>(
+        ifn.vkGetDeviceProcAddr(vulkan_device->device(), "vkCmdWriteTimestamp"));
+    get_query_pool_results_ = reinterpret_cast<PFN_vkGetQueryPoolResults>(
+        ifn.vkGetDeviceProcAddr(vulkan_device->device(), "vkGetQueryPoolResults"));
+    std::fprintf(file_, "# device %s, timestamp period %g ns, %u valid bits\n",
+                 properties.deviceName, timestamp_period_ns_, valid_bits);
+    if (!valid_bits || timestamp_period_ns_ <= 0.0f || !cmd_write_timestamp_ ||
+        !get_query_pool_results_) {
+      std::fprintf(file_, "# timestamps are not supported on this queue, timing disabled\n");
+      std::fclose(file_);
+      file_ = nullptr;
+      return;
+    }
+    const char* per_draw = std::getenv("AUTOPORT_GPU_TIMING_PER_DRAW");
+    per_draw_ = per_draw && *per_draw && std::string(per_draw) != "0";
+    if (per_draw_) {
+      std::fprintf(file_, "# per-draw mode: one render pass per guest draw\n");
+    }
+    std::fprintf(file_,
+                 "# seconds frame kind gpu_ms gap_ms size draws description gap_work\n"
+                 "# kinds: D game draws, X EDRAM transfer/clear, P copy to window, "
+                 "S/E submission start/end markers\n");
+    std::fflush(file_);
+  }
+
+  void Shutdown() {
+    if (vulkan_device_) {
+      const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device_->functions();
+      VkDevice device = vulkan_device_->device();
+      for (Submission& submission : pending_) {
+        dfn.vkDestroyQueryPool(device, submission.pool, nullptr);
+      }
+      if (current_.pool != VK_NULL_HANDLE) {
+        dfn.vkDestroyQueryPool(device, current_.pool, nullptr);
+      }
+      for (VkQueryPool pool : free_pools_) {
+        dfn.vkDestroyQueryPool(device, pool, nullptr);
+      }
+      vulkan_device_ = nullptr;
+    }
+    pending_.clear();
+    current_ = {};
+    free_pools_.clear();
+    if (file_) {
+      std::fclose(file_);
+      file_ = nullptr;
+    }
+  }
+
+  // Called right before a render pass begins, outside any render pass.
+  void BeginPass(DeferredCommandBuffer& command_buffer, uint64_t submission, char kind,
+                 uint32_t width, uint32_t height, std::string description) {
+    if (!file_) {
+      return;
+    }
+    pass_open_ = false;
+    if (current_.pool != VK_NULL_HANDLE && current_.submission != submission) {
+      // A submission ended without SubmissionEnded; its results can't be matched.
+      free_pools_.push_back(current_.pool);
+      current_ = {};
+    }
+    if (current_.pool == VK_NULL_HANDLE) {
+      VkQueryPool pool = AcquirePool();
+      if (pool == VK_NULL_HANDLE) {
+        return;
+      }
+      current_.pool = pool;
+      current_.submission = submission;
+      command_buffer.CmdVkResetQueryPool(pool, 0, kQueriesPerPool);
+    }
+    if ((current_.passes.size() + 1) * 2 > kQueriesPerPool) {
+      ++dropped_passes_;
+      TakeGapWork();
+      return;
+    }
+    Pass& pass = current_.passes.emplace_back();
+    pass.seconds = Now();
+    pass.frame = frame_;
+    pass.kind = kind;
+    pass.width = width;
+    pass.height = height;
+    pass.description = std::move(description);
+    pass.gap_work = TakeGapWork();
+    command_buffer.CmdVkWriteTimestamp(cmd_write_timestamp_, VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT,
+                                       current_.pool,
+                                       uint32_t(current_.passes.size() - 1) * 2);
+    pass_open_ = true;
+  }
+
+  // Called right after a render pass ends.
+  void EndPass(DeferredCommandBuffer& command_buffer) {
+    if (!pass_open_) {
+      return;
+    }
+    pass_open_ = false;
+    command_buffer.CmdVkWriteTimestamp(cmd_write_timestamp_, VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT,
+                                       current_.pool,
+                                       uint32_t(current_.passes.size() - 1) * 2 + 1);
+  }
+
+  // A zero-length pass, timing only the gap before it.
+  void Mark(DeferredCommandBuffer& command_buffer, uint64_t submission, char kind) {
+    if (!file_) {
+      return;
+    }
+    BeginPass(command_buffer, submission, kind, 0, 0, "-");
+    EndPass(command_buffer);
+  }
+
+  // Records that GPU work of a kind (a letter, see the top of the file) was
+  // recorded outside render passes, attributed to the next pass's gap.
+  void NoteGapWork(char kind) {
+    if (file_ && kind >= 'a' && kind <= 'z') {
+      ++gap_work_[kind - 'a'];
+    }
+  }
+
+  void CountDraw(uint64_t vertex_shader_hash, uint64_t pixel_shader_hash,
+                 uint32_t vertex_count) {
+    if (!pass_open_) {
+      return;
+    }
+    Pass& pass = current_.passes.back();
+    if (++pass.draws == 1 && per_draw_) {
+      char label[80];
+      std::snprintf(label, sizeof(label), ",vs=%016llX,ps=%016llX,v=%u",
+                    (unsigned long long)vertex_shader_hash, (unsigned long long)pixel_shader_hash,
+                    vertex_count);
+      pass.description += label;
+    }
+  }
+
+  // In per-draw mode, whether the open pass already holds a draw, so the next
+  // draw should start a new pass.
+  bool ShouldSplitBeforeDraw() const {
+    return per_draw_ && pass_open_ && current_.passes.back().draws != 0;
+  }
+
+  // Called after the submission's command buffer was submitted.
+  void SubmissionEnded(uint64_t submission) {
+    if (!file_ || current_.pool == VK_NULL_HANDLE) {
+      return;
+    }
+    if (current_.submission == submission) {
+      pending_.push_back(std::move(current_));
+    } else {
+      free_pools_.push_back(current_.pool);
+    }
+    current_ = {};
+    pass_open_ = false;
+  }
+
+  // Writes the passes of completed submissions; never waits for the GPU.
+  void Collect(uint64_t completed_submission) {
+    if (!file_) {
+      return;
+    }
+    VkDevice device = vulkan_device_->device();
+    while (!pending_.empty() && pending_.front().submission <= completed_submission) {
+      Submission& submission = pending_.front();
+      uint32_t query_count = uint32_t(submission.passes.size()) * 2;
+      results_.resize(query_count);
+      VkResult result = query_count
+          ? get_query_pool_results_(device, submission.pool, 0, query_count,
+                                      sizeof(uint64_t) * query_count, results_.data(),
+                                      sizeof(uint64_t), VK_QUERY_RESULT_64_BIT)
+          : VK_SUCCESS;
+      if (result == VK_NOT_READY) {
+        break;
+      }
+      if (result == VK_SUCCESS) {
+        for (size_t i = 0; i < submission.passes.size(); ++i) {
+          const Pass& pass = submission.passes[i];
+          double gpu_ms = TicksToMs(results_[i * 2], results_[i * 2 + 1]);
+          double gap_ms = i ? TicksToMs(results_[i * 2 - 1], results_[i * 2]) : -1.0;
+          std::fprintf(file_, "%.4f %llu %c %.4f %.4f %ux%u %u %s %s\n", pass.seconds,
+                       (unsigned long long)pass.frame, pass.kind, gpu_ms, gap_ms, pass.width,
+                       pass.height, pass.draws, pass.description.c_str(), pass.gap_work.c_str());
+        }
+      }
+      free_pools_.push_back(submission.pool);
+      pending_.pop_front();
+    }
+    if (dropped_passes_) {
+      std::fprintf(file_, "# %u passes not timed (more than %u in one submission)\n",
+                   dropped_passes_, kQueriesPerPool / 2);
+      dropped_passes_ = 0;
+    }
+    std::fflush(file_);
+  }
+
+  void FrameEnded() { ++frame_; }
+
+ private:
+  static constexpr uint32_t kQueriesPerPool = 4096;
+
+  struct Pass {
+    double seconds = 0.0;
+    uint64_t frame = 0;
+    char kind = '?';
+    uint32_t width = 0;
+    uint32_t height = 0;
+    uint32_t draws = 0;
+    std::string description;
+    std::string gap_work;
+  };
+
+  struct Submission {
+    VkQueryPool pool = VK_NULL_HANDLE;
+    uint64_t submission = 0;
+    std::vector<Pass> passes;
+  };
+
+  static double Now() {
+    static const auto start = std::chrono::steady_clock::now();
+    return std::chrono::duration<double>(std::chrono::steady_clock::now() - start).count();
+  }
+
+  double TicksToMs(uint64_t begin, uint64_t end) const {
+    uint64_t ticks = (end - begin) & timestamp_mask_;
+    return double(ticks) * double(timestamp_period_ns_) * 1e-6;
+  }
+
+  std::string TakeGapWork() {
+    std::string work;
+    for (uint32_t i = 0; i < 26; ++i) {
+      if (gap_work_[i]) {
+        work += char('a' + i);
+        work += std::to_string(gap_work_[i]);
+        gap_work_[i] = 0;
+      }
+    }
+    return work.empty() ? "-" : work;
+  }
+
+  VkQueryPool AcquirePool() {
+    if (!free_pools_.empty()) {
+      VkQueryPool pool = free_pools_.back();
+      free_pools_.pop_back();
+      return pool;
+    }
+    VkQueryPoolCreateInfo create_info = {VK_STRUCTURE_TYPE_QUERY_POOL_CREATE_INFO};
+    create_info.queryType = VK_QUERY_TYPE_TIMESTAMP;
+    create_info.queryCount = kQueriesPerPool;
+    VkQueryPool pool = VK_NULL_HANDLE;
+    if (vulkan_device_->functions().vkCreateQueryPool(vulkan_device_->device(), &create_info,
+                                                       nullptr, &pool) != VK_SUCCESS) {
+      return VK_NULL_HANDLE;
+    }
+    return pool;
+  }
+
+  FILE* file_ = nullptr;
+  const ui::vulkan::VulkanDevice* vulkan_device_ = nullptr;
+  float timestamp_period_ns_ = 0.0f;
+  uint64_t timestamp_mask_ = 0;
+  PFN_vkCmdWriteTimestamp cmd_write_timestamp_ = nullptr;
+  PFN_vkGetQueryPoolResults get_query_pool_results_ = nullptr;
+  uint64_t frame_ = 0;
+  bool pass_open_ = false;
+  bool per_draw_ = false;
+  uint32_t dropped_passes_ = 0;
+  uint32_t gap_work_[26] = {};
+  Submission current_;
+  std::deque<Submission> pending_;
+  std::vector<VkQueryPool> free_pools_;
+  std::vector<uint64_t> results_;
+};
+
+}  // namespace rex::graphics::vulkan
