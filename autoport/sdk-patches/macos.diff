+// autoport: AUTOPORT_SKIP_SHADERS=<hash>[,<hash>...] drops every draw that uses
+// one of these vertex or pixel shaders (16 hex digits, as in --dump_shaders file
+// names), to see what an expensive shader draws and how much skipping it saves.
+// AUTOPORT_SKIP_SHADERS_FILE=<path> reads the list from a file instead, reloaded
+// when it changes, and every two seconds writes the shaders drawn in that time
+// to <path>.used ("ps <hash> <draws>" / "vs <hash> <draws>"), so the shader
+// behind an artifact can be bisected live (tools/shader-bisect.py).
+std::vector<uint64_t> ParseSkippedShaderList(const char* list) {
+  std::vector<uint64_t> hashes;
+  while (list && *list) {
+    while (*list == ',' || *list == ' ' || *list == '\n' || *list == '\r') {
+      ++list;
+    }
+    if (!*list) {
+      break;
+    }
+    char* end = nullptr;
+    uint64_t hash = std::strtoull(list, &end, 16);
+    if (end == list) {
+      break;
+    }
+    hashes.push_back(hash);
+    list = end;
+  }
+  return hashes;
+}
