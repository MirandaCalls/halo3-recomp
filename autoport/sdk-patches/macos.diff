+    Id descriptor = Send<Id>(Send<Id>(get_class_("MTLCaptureDescriptor"), "alloc"), "init");
+    Send<void>(descriptor, "setCaptureObject:", device);
+    Send<void>(descriptor, "setDestination:", kGpuTraceDocument);
