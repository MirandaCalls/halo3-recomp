+bool IsShaderSkippedForDiagnostics(uint64_t vertex_shader_hash, uint64_t pixel_shader_hash) {
+  static std::vector<uint64_t> skipped = [] {
+    std::vector<uint64_t> hashes = ParseSkippedShaderList(std::getenv("AUTOPORT_SKIP_SHADERS"));
+    for (uint64_t hash : hashes) {
+      REXGPU_INFO("autoport: skipping draws that use shader {:016X}", hash);
+    }
+    return hashes;
+  }();
+  static const char* const skip_file = std::getenv("AUTOPORT_SKIP_SHADERS_FILE");
+  if (skip_file) {
+    static std::map<uint64_t, uint32_t> used_vs, used_ps;
+    static auto next_check = std::chrono::steady_clock::now();
+    static auto next_used_write = next_check + std::chrono::seconds(2);
+    static std::filesystem::file_time_type loaded_time;
+    ++used_vs[vertex_shader_hash];
+    if (pixel_shader_hash) {
+      ++used_ps[pixel_shader_hash];
+    }
+    auto now = std::chrono::steady_clock::now();
+    if (now >= next_check) {
+      next_check = now + std::chrono::milliseconds(250);
+      std::error_code ec;
+      auto time = std::filesystem::last_write_time(skip_file, ec);
+      if (ec) {
+        skipped.clear();
+      } else if (time != loaded_time) {
+        loaded_time = time;
+        std::ifstream in(skip_file);
+        std::string text((std::istreambuf_iterator<char>(in)), std::istreambuf_iterator<char>());
+        skipped = ParseSkippedShaderList(text.c_str());
+        REXGPU_INFO("autoport: skipping draws that use {} shader(s) from {}", skipped.size(),
+                    skip_file);
+      }
+      if (now >= next_used_write) {
+        next_used_write = now + std::chrono::seconds(2);
+        std::string used_path = std::string(skip_file) + ".used";
+        std::string temp_path = used_path + ".tmp";
+        {
+          std::ofstream out(temp_path, std::ios::trunc);
+          for (const auto& [hash, draws] : used_ps) {
+            out << fmt::format("ps {:016X} {}\n", hash, draws);
+          }
+          for (const auto& [hash, draws] : used_vs) {
+            out << fmt::format("vs {:016X} {}\n", hash, draws);
+          }
+        }
+        std::filesystem::rename(temp_path, used_path, ec);
+        used_vs.clear();
+        used_ps.clear();
+      }
+    }
+  }
+  if (skipped.empty()) {
+    return false;
+  }
+  for (uint64_t hash : skipped) {
+    if (hash == vertex_shader_hash || (pixel_shader_hash && hash == pixel_shader_hash)) {
+      return true;
+    }
+  }
+  return false;
+}
