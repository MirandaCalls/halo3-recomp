+void VulkanSharedMemory::UseForGuestDraw(const std::pair<uint32_t, uint32_t>* read_ranges,
+                                         size_t read_range_count,
+                                         std::pair<uint32_t, uint32_t> written_range) {
+  written_range.first = std::min(written_range.first, kBufferSize);
+  written_range.second = std::min(written_range.second, kBufferSize - written_range.first);
+  bool writes = written_range.second != 0;
+  if (last_usage_ != Usage::kGuestDrawReadWrite) {
+    if (!writes) {
+      Use(Usage::kRead);
+      return;
+    }
+    // Entering memexport: one full barrier, then track accesses.
+    Use(Usage::kGuestDrawReadWrite);
+    draw_reads_since_barrier_.Clear();
+    draw_writes_since_barrier_.Clear();
+  }
+  bool conflict = false;
+  for (size_t i = 0; i < read_range_count && !conflict; ++i) {
+    uint32_t start = std::min(read_ranges[i].first, kBufferSize);
+    uint32_t end = start + std::min(read_ranges[i].second, kBufferSize - start);
+    conflict = draw_writes_since_barrier_.Overlaps(start, end);
+  }
+  uint32_t written_end = written_range.first + written_range.second;
+  if (!conflict && writes) {
+    conflict = draw_writes_since_barrier_.Overlaps(written_range.first, written_end) ||
+               draw_reads_since_barrier_.Overlaps(written_range.first, written_end);
+  }
+  // autoport: AUTOPORT_MEMEXPORT_BARRIERS=never drops these barriers to
+  // measure what the render passes they split cost (unsafe: draws may read
+  // stale memexported data).
+  static const bool barriers_never = [] {
+    const char* value = std::getenv("AUTOPORT_MEMEXPORT_BARRIERS");
+    return value && !std::strcmp(value, "never");
+  }();
+  if (conflict && barriers_never) {
+    conflict = false;
+  }
+  if (conflict) {
+    VkPipelineStageFlags stage_mask;
+    VkAccessFlags access_mask;
+    GetUsageMasks(Usage::kGuestDrawReadWrite, stage_mask, access_mask);
+    command_processor_.PushBufferMemoryBarrier(buffer_, 0, VK_WHOLE_SIZE, stage_mask, stage_mask,
+                                               access_mask, access_mask, VK_QUEUE_FAMILY_IGNORED,
+                                               VK_QUEUE_FAMILY_IGNORED, false);
+    draw_reads_since_barrier_.Clear();
+    draw_writes_since_barrier_.Clear();
+  }
+  for (size_t i = 0; i < read_range_count; ++i) {
+    uint32_t start = std::min(read_ranges[i].first, kBufferSize);
+    draw_reads_since_barrier_.Add(start,
+                                  start + std::min(read_ranges[i].second, kBufferSize - start));
+  }
