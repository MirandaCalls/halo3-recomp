+VkPipeline VulkanPipelineCache::GetOrCreateLibrary(const std::string& key,
+                                                   const VkGraphicsPipelineCreateInfo& create_info) {
+  {
+    std::lock_guard<std::mutex> lock(library_mutex_);
+    auto it = library_pipelines_.find(key);
+    if (it != library_pipelines_.end()) {
+      return it->second;
+    }
+  }
+  // Created outside the lock so several creation threads can compile shader
+  // libraries in parallel; a duplicate from a race is destroyed.
+  const ui::vulkan::VulkanDevice* const vulkan_device = command_processor_.GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  VkPipeline library = VK_NULL_HANDLE;
+  VkResult result =
+      dfn.vkCreateGraphicsPipelines(device, VK_NULL_HANDLE, 1, &create_info, nullptr, &library);
+  if (result != VK_SUCCESS) {
+    REXGPU_ERROR("VulkanPipelineCache: failed to create a pipeline library (result={})",
+                 int32_t(result));
+    return VK_NULL_HANDLE;
+  }
+  std::lock_guard<std::mutex> lock(library_mutex_);
+  auto [it, inserted] = library_pipelines_.emplace(key, library);
+  if (!inserted) {
+    dfn.vkDestroyPipeline(device, library, nullptr);
+  }
+  return it->second;
