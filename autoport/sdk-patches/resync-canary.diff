diff --git a/include/rex/graphics/util/stutter_log.h b/include/rex/graphics/util/stutter_log.h
new file mode 100644
index 0000000..e68436a
--- /dev/null
+++ b/include/rex/graphics/util/stutter_log.h
@@ -0,0 +1,67 @@
+/**
+ * autoport: lightweight GPU event log for stutter attribution.
+ *
+ * Enabled with AUTOPORT_STUTTER_LOG=<file>. Each line is
+ *   <seconds since start> <kind> <milliseconds> <hex argument> <thread>
+ * kinds: S guest swap (IssueSwap), K swap skipped (async placeholder in frame),
+ *        P pipeline creation, T texture load.
+ */
+#pragma once
+
+#include <chrono>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <functional>
+#include <mutex>
+#include <thread>
+
+namespace rex::graphics::stutter {
+
+inline FILE* File() {
+  static FILE* file = [] {
+    const char* path = std::getenv("AUTOPORT_STUTTER_LOG");
+    return path ? std::fopen(path, "w") : nullptr;
+  }();
+  return file;
+}
+
+inline double Now() {
+  static const auto start = std::chrono::steady_clock::now();
+  return std::chrono::duration<double>(std::chrono::steady_clock::now() - start).count();
+}
+
+inline void Event(char kind, double ms, uint64_t arg = 0) {
+  FILE* file = File();
+  if (!file) return;
+  static std::mutex mutex;
+  const double t = Now();
+  const size_t thread = std::hash<std::thread::id>()(std::this_thread::get_id()) & 0xFFFF;
+  std::lock_guard<std::mutex> lock(mutex);
+  std::fprintf(file, "%.4f %c %.3f %llx %04zx\n", t, kind, ms, (unsigned long long)arg, thread);
+  std::fflush(file);
+}
+
+// Logs the scope's duration as one event (only when logging is enabled).
+class Scope {
+ public:
+  Scope(char kind, uint64_t arg = 0) : kind_(kind), arg_(arg), enabled_(File() != nullptr) {
+    if (enabled_) start_ = std::chrono::steady_clock::now();
+  }
+  ~Scope() {
+    if (enabled_) {
+      Event(kind_,
+            std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - start_)
+                .count(),
+            arg_);
+    }
+  }
+
+ private:
+  char kind_;
+  uint64_t arg_;
+  bool enabled_;
+  std::chrono::steady_clock::time_point start_;
+};
+
+}  // namespace rex::graphics::stutter
